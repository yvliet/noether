{
  "name": "flint-extension-starter",
  "version": "1.0.0",
  "description": "Official starter template for building community extensions for Flint",
  "main": "dist/main.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "flint",
    "flint-extension",
    "flint-plugin"
  ],
  "author": "Your Name <you@example.com>",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "flint": "^0.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  }
}
