# Turso Database Configuration for Flint Community Registry
# Format: libsql://<your-db-name>-<org-or-user>.turso.io
DATABASE_URL=libsql://your-database.turso.io

# Turso Authentication Token
# Generate using: turso db tokens create <database-name>
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQ...

# Optional Port for local standalone API server (default: 3001)
PORT=3001
